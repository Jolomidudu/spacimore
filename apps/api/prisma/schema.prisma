generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  ANONYMIZED

  @@map("user_status")
}

enum VerificationChallengePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("verification_challenge_purpose")
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED

  @@map("business_status")
}

enum BusinessMembershipRole {
  OWNER
  ADMIN
  MEMBER

  @@map("business_membership_role")
}

enum BusinessMembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED

  @@map("business_membership_status")
}

enum RoleCode {
  SUPER_ADMIN
  ADMIN
  OPERATIONS
  CUSTOMER_SUPPORT

  @@map("role_code")
}

enum AuditActorType {
  USER
  SYSTEM

  @@map("audit_actor_type")
}

model User {
  id                     String                  @id @default(uuid()) @db.Uuid
  email                  String                  @unique(map: "users_email_key") @db.VarChar(320)
  emailVerifiedAt        DateTime?               @map("email_verified_at") @db.Timestamptz(6)
  status                 UserStatus              @default(PENDING_VERIFICATION)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  anonymizedAt           DateTime?               @map("anonymized_at") @db.Timestamptz(6)
  passwordCredential     PasswordCredential?
  verificationChallenges VerificationChallenge[]
  authSessions           AuthSession[]
  roleAssignments        UserRole[]              @relation("UserRoleSubject")
  roleGrantsMade         UserRole[]              @relation("UserRoleAssignedBy")
  roleRevocationsMade    UserRole[]              @relation("UserRoleRevokedBy")
  businessesCreated      Business[]              @relation("BusinessCreator")
  businessMemberships    BusinessMembership[]    @relation("MembershipUser")
  membershipsInvited     BusinessMembership[]    @relation("MembershipInviter")
  membershipsRevoked     BusinessMembership[]    @relation("MembershipRevoker")
  auditEvents            AuditLog[]              @relation("AuditActor")

  @@map("users")
}

model PasswordCredential {
  userId            String    @id @map("user_id") @db.Uuid
  passwordHash      String    @map("password_hash") @db.Text
  passwordChangedAt DateTime  @map("password_changed_at") @db.Timestamptz(6)
  disabledAt        DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("password_credentials")
}

model VerificationChallenge {
  id           String                       @id @default(uuid()) @db.Uuid
  userId       String                       @map("user_id") @db.Uuid
  purpose      VerificationChallengePurpose
  tokenHash    String                       @unique(map: "verification_challenges_token_hash_key") @map("token_hash") @db.VarChar(255)
  expiresAt    DateTime                     @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime?                    @map("consumed_at") @db.Timestamptz(6)
  attemptCount Int                          @default(0) @map("attempt_count")
  createdAt    DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User                         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  emailOutbox  VerificationEmailOutbox?

  @@index([userId, purpose, createdAt], map: "verification_challenges_user_purpose_created_at_idx")
  @@index([expiresAt, consumedAt], map: "verification_challenges_expires_consumed_at_idx")
  @@map("verification_challenges")
}

model VerificationEmailOutbox {
  id                           String                @id @default(uuid()) @db.Uuid
  challengeId                  String                @unique(map: "verification_email_outbox_challenge_id_key") @map("challenge_id") @db.Uuid
  tokenCiphertext              String                @map("token_ciphertext") @db.Text
  tokenNonce                   String                @map("token_nonce") @db.VarChar(24)
  tokenAuthTag                 String                @map("token_auth_tag") @db.VarChar(32)
  /// Legacy mixed counter retained for existing data; do not use for retry policy.
  legacyAttempts               Int                   @default(0) @map("attempts")
  claimCount                   Int                   @default(0) @map("claim_count")
  abandonedClaimCount          Int                   @default(0) @map("abandoned_claim_count")
  deliveryAttempts             Int                   @default(0) @map("delivery_attempts")
  lastDeliveryAttemptLockToken String?               @map("last_delivery_attempt_lock_token") @db.Uuid
  availableAt                  DateTime              @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedAt                     DateTime?             @map("locked_at") @db.Timestamptz(6)
  lockToken                    String?               @map("lock_token") @db.Uuid
  deliveredAt                  DateTime?             @map("delivered_at") @db.Timestamptz(6)
  failedAt                     DateTime?             @map("failed_at") @db.Timestamptz(6)
  failureCode                  String?               @map("failure_code") @db.VarChar(64)
  createdAt                    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  challenge                    VerificationChallenge @relation(fields: [challengeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([deliveredAt, failedAt, availableAt, lockedAt, createdAt], map: "verification_email_outbox_pending_idx")
  @@map("verification_email_outbox")
}

model AuthSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt    DateTime?      @map("last_seen_at") @db.Timestamptz(6)
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(6)
  revokeReason  String?        @map("revoke_reason") @db.VarChar(64)
  userAgent     String?        @map("user_agent") @db.VarChar(512)
  ipAddress     String?        @map("ip_address") @db.Inet
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt, expiresAt], map: "auth_sessions_user_revoked_expires_at_idx")
  @@map("auth_sessions")
}

model RefreshToken {
  id                String        @id @default(uuid()) @db.Uuid
  sessionId         String        @map("session_id") @db.Uuid
  tokenHash         String        @unique(map: "refresh_tokens_token_hash_key") @map("token_hash") @db.VarChar(255)
  issuedAt          DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt         DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt        DateTime?     @map("consumed_at") @db.Timestamptz(6)
  revokedAt         DateTime?     @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenId String?       @unique(map: "refresh_tokens_replaced_by_token_id_key") @map("replaced_by_token_id") @db.Uuid
  session           AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  replacedBy        RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId, sessionId], references: [id, sessionId], onDelete: Restrict, onUpdate: Cascade)
  replaces          RefreshToken? @relation("RefreshTokenRotation")

  @@unique([id, sessionId], map: "refresh_tokens_id_session_id_key")
  @@unique([replacedByTokenId, sessionId], map: "refresh_tokens_replaced_by_session_id_key")
  @@index([sessionId, issuedAt], map: "refresh_tokens_session_issued_at_idx")
  @@index([sessionId, consumedAt, revokedAt], map: "refresh_tokens_session_consumed_revoked_idx")
  @@map("refresh_tokens")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        RoleCode         @unique(map: "roles_code_key")
  name        String           @db.VarChar(120)
  description String?          @db.Text
  isSystem    Boolean          @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  permissions RolePermission[]
  assignments UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique(map: "permissions_code_key") @db.VarChar(128)
  description String           @db.Text
  isSystem    Boolean          @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permission_id_idx")
  @@map("role_permissions")
}

model UserRole {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  roleId           String    @map("role_id") @db.Uuid
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  revokedByUserId  String?   @map("revoked_by_user_id") @db.Uuid
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  user             User      @relation("UserRoleSubject", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role             Role      @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedBy       User?     @relation("UserRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  revokedBy        User?     @relation("UserRoleRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, assignedAt], map: "user_roles_user_assigned_at_idx")
  @@index([roleId, revokedAt], map: "user_roles_role_revoked_at_idx")
  @@map("user_roles")
}

model Business {
  id              String               @id @default(uuid()) @db.Uuid
  legalName       String               @map("legal_name") @db.VarChar(255)
  countryCode     String               @map("country_code") @db.Char(2)
  status          BusinessStatus       @default(PENDING)
  createdByUserId String               @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       User                 @relation("BusinessCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  memberships     BusinessMembership[]

  @@index([createdByUserId, createdAt], map: "businesses_created_by_created_at_idx")
  @@map("businesses")
}

model BusinessMembership {
  id              String                   @id @default(uuid()) @db.Uuid
  businessId      String                   @map("business_id") @db.Uuid
  userId          String                   @map("user_id") @db.Uuid
  membershipRole  BusinessMembershipRole   @map("membership_role")
  status          BusinessMembershipStatus @default(INVITED)
  invitedByUserId String?                  @map("invited_by_user_id") @db.Uuid
  revokedByUserId String?                  @map("revoked_by_user_id") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  acceptedAt      DateTime?                @map("accepted_at") @db.Timestamptz(6)
  revokedAt       DateTime?                @map("revoked_at") @db.Timestamptz(6)
  business        Business                 @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user            User                     @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  invitedBy       User?                    @relation("MembershipInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  revokedBy       User?                    @relation("MembershipRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, status, createdAt], map: "business_memberships_user_status_created_at_idx")
  @@index([businessId, status, createdAt], map: "business_memberships_business_status_created_at_idx")
  @@map("business_memberships")
}

model AuditLog {
  id          String         @id @default(uuid()) @db.Uuid
  actorUserId String?        @map("actor_user_id") @db.Uuid
  actorType   AuditActorType @map("actor_type")
  action      String         @db.VarChar(128)
  targetType  String         @map("target_type") @db.VarChar(128)
  targetId    String?        @map("target_id") @db.Uuid
  occurredAt  DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  requestId   String?        @map("request_id") @db.VarChar(128)
  outcome     String         @db.VarChar(64)
  metadata    Json?          @db.JsonB
  actor       User?          @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([targetType, targetId, occurredAt], map: "audit_logs_target_occurred_at_idx")
  @@index([actorUserId, occurredAt], map: "audit_logs_actor_occurred_at_idx")
  @@index([requestId], map: "audit_logs_request_id_idx")
  @@map("audit_logs")
}
